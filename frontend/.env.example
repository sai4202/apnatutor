# ApnaTutor frontend — environment variable reference
#
# Copy to .env.local and adjust. Next.js loads .env.local from this directory
# automatically. NEVER commit .env.local.
#
# Frontend-only: the backend has its own backend/.env.example.

# Base URL of the backend API, including the /api/v1 prefix.
# NEXT_PUBLIC_* is compiled into the browser bundle and is therefore public.
# Never put a secret behind that prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
